<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SalesRecord" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="actionBarSize">@dimen/action_bar_size</item>
    </style>

    <style name="Theme.SalesRecord.NoActionBar" parent="Theme.SalesRecord">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.SalesRecord.Fullscreen" parent="Theme.SalesRecord">
        <!-- Nota: Asegúrate de tener definido Widget.Theme.SalesRecord.ActionBar.Fullscreen en tu proyecto si usas esta línea -->
        <item name="android:actionBarStyle">@style/Widget.Theme.SalesRecord.ActionBar.Fullscreen</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <!-- MODIFICADO: Apunta a los nuevos nombres planos sin puntos conflictivos -->
    <style name="ThemeOverlay.SalesRecord.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>

        <!-- Sobrescribimos los estilos por defecto usando nombres limpios -->
        <item name="checkboxStyle">@style/Widget_SalesRecord_Fullscreen_CheckBox</item>
        <item name="materialButtonStyle">@style/Widget_SalesRecord_Fullscreen_Button</item>
    </style>

    <!-- CAMBIADO: Usamos guiones bajos (_) para evitar que AAPT busque padres automáticos -->
    <style name="Widget_SalesRecord_Fullscreen_Base">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ESTILO PARA EL CHECKBOX (Hereda del diseño oficial de Material Components) -->
    <style name="Widget_SalesRecord_Fullscreen_CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item> <!-- Texto más grande y legible -->
        <item name="android:paddingStart">8dp</item> <!-- Separación entre la casilla y el texto -->
        <item name="backgroundTint">@color/light_blue_600</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>

        <item name="buttonTint">?attr/colorSecondary</item>
    </style>

    <!-- ESTILO PARA EL BOTÓN (Hereda del diseño oficial de Material Components) -->
    <style name="Widget_SalesRecord_Fullscreen_Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item> <!-- Texto más grande y legible -->
        <item name="android:insetTop">0dp</item> <!-- Elimina márgenes invisibles del botón -->
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/light_blue_600</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>
</resources>
