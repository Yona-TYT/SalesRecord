<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo principal del elemento (Mantiene tu color actual) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/text_background2" />
        </shape>
    </item>

    <!-- Línea divisoria en la base -->
    <item android:bottom="0dp" android:top="-2dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <!-- Usa un color gris sutil o el color de tus textos con opacidad baja -->
            <stroke android:width="1dp" android:color="#33757575" />
        </shape>
    </item>
</layer-list>