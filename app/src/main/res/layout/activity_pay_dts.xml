<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.PayDetailsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_dts"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Sección Total ===== -->
    <TextView
        android:id="@+id/tx_dts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="2dp"
        android:gravity="center"
        android:text="Total:"
        android:textSize="@dimen/inner_text_3"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/toolbar_dts" />

    <TextView
        android:id="@+id/txtotal_dts1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="2dp"
        android:text="Actual:"
        android:textSize="@dimen/inner_text_2"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/tx_dts" />

    <TextView
        android:id="@+id/txtotal_dts2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="2dp"
        android:text=""
        android:textSize="@dimen/inner_text_2"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintTop_toBottomOf="@id/txtotal_dts1" />

    <!-- ===== Fila QR (GONE por defecto) ===== -->
    <TextView
        android:id="@+id/text_dts1"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_hs"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:padding="2dp"
        android:text="Datos de Pago con QR:"
        android:textSize="@dimen/inner_text_2"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:visibility="gone"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/butt_dts0"
        app:layout_constraintTop_toBottomOf="@id/txtotal_dts2" />

    <ImageButton
        android:id="@+id/butt_dts0"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_hs"
        android:src="@drawable/abc_ic_menu_copy_mtrl_am_alpha"
        android:scaleType="centerInside"
        android:background="@color/button"
        android:visibility="gone"
        app:layout_constraintHorizontal_weight="0.3"
        app:layout_constraintTop_toTopOf="@id/text_dts1"
        app:layout_constraintBottom_toBottomOf="@id/text_dts1"
        app:layout_constraintStart_toEndOf="@id/text_dts1"
        app:layout_constraintEnd_toStartOf="@id/butt_dts1" />

    <ImageButton
        android:id="@+id/butt_dts1"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_hs"
        android:layout_marginStart="5dp"
        android:src="@drawable/ic_qr_scan"
        android:scaleType="centerInside"
        android:padding="3dp"
        android:background="@color/button"
        android:visibility="gone"
        app:layout_constraintHorizontal_weight="0.3"
        app:layout_constraintTop_toTopOf="@id/text_dts1"
        app:layout_constraintBottom_toBottomOf="@id/text_dts1"
        app:layout_constraintStart_toEndOf="@id/butt_dts0"
        app:layout_constraintEnd_toEndOf="@id/guideline2" />

    <!-- Barrier: se posiciona debajo del último elemento visible de la zona superior -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="txtotal_dts2,text_dts1,butt_dts1" />

    <!-- ===== ListView principal (se expande) ===== -->
    <ListView
        android:id="@+id/pay_dts_viewList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/barrier_top"
        app:layout_constraintBottom_toTopOf="@id/txview_dts2"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2" />

    <!-- Barrier que marca el inicio de la sección inferior fija -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_bottom_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:barrierAllowsGoneWidgets="false"
        app:constraint_referenced_ids="input_dts1,pay_dts_viewList2,txview_dts2" />

    <!-- ===== Views opcionales (gone) ===== -->
    <AutoCompleteTextView
        android:id="@+id/input_dts1"
        android:layout_width="0dp"
        android:layout_height="@dimen/txview_h2"
        android:layout_marginTop="8dp"
        android:background="@color/text_background"
        android:completionThreshold="1"
        android:hint="Buscar Nombre:"
        android:enabled="true"

        android:imeOptions="actionDone"
        android:inputType="textPersonName|textCapWords"
        android:maxLines="1"
        android:padding="@dimen/txview_pad2"
        android:textSize="@dimen/inner_text_1"
        android:textStyle="bold"
        android:visibility="gone"

        app:layout_constraintBottom_toTopOf="@id/txview_dts2"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
    />

    <ListView
        android:id="@+id/pay_dts_viewList2"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintBottom_toTopOf="@id/input_dts1" />

    <!-- ===== Sección inferior (anclada desde abajo) ===== -->
    <TextView
        android:id="@+id/txview_dts2"
        android:layout_width="0dp"
        android:layout_height="@dimen/txview_h2"
        android:padding="@dimen/txview_pad2"
        android:text="Vacio"
        android:textSize="@dimen/inner_text_1"
        android:textStyle="bold"
        android:background="@color/text_background"
        android:gravity="center_vertical"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/butt_dts4"
        app:layout_constraintBottom_toTopOf="@id/txview_dts3" />

    <ToggleButton
        android:id="@+id/butt_dts4"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_h1"
        android:backgroundTint="@color/button"
        android:textColor="@color/inner_button"
        android:checked="false"
        android:textOff="Editar"
        android:textOn="OK"
        android:textSize="@dimen/inner_text_1"
        app:layout_constraintHorizontal_weight="0.4"
        app:layout_constraintTop_toTopOf="@id/txview_dts2"
        app:layout_constraintBottom_toBottomOf="@id/txview_dts2"
        app:layout_constraintStart_toEndOf="@id/txview_dts2"
        app:layout_constraintEnd_toEndOf="@id/guideline2" />

    <TextView
        android:id="@+id/txview_dts3"
        android:layout_width="0dp"
        android:layout_height="@dimen/txview_h2"
        android:padding="@dimen/txview_pad2"
        android:text="Vacio"
        android:textSize="@dimen/inner_text_1"
        android:textStyle="bold"
        android:background="@color/text_background"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintBottom_toTopOf="@id/txview_dts4" />

    <TextView
        android:id="@+id/txview_dts4"
        android:layout_width="0dp"
        android:layout_height="@dimen/txview_h2"
        android:padding="@dimen/txview_pad2"
        android:text="Vacio"
        android:textSize="@dimen/inner_text_1"
        android:textStyle="bold"
        android:background="@color/text_background"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintBottom_toTopOf="@id/txview_dts5" />

    <TextView
        android:id="@+id/txview_dts5"
        android:layout_width="0dp"
        android:layout_height="@dimen/txview_h2"
        android:padding="@dimen/txview_pad2"
        android:text="Vacio"
        android:textSize="@dimen/inner_text_1"
        android:textStyle="bold"
        android:background="@color/text_background"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintBottom_toTopOf="@id/txview_dts6" />

    <TextView
        android:id="@+id/txview_dts6"
        android:layout_width="0dp"
        android:layout_height="@dimen/txview_h2"
        android:padding="@dimen/txview_pad2"
        android:text="Vacio"
        android:textSize="@dimen/inner_text_1"
        android:textStyle="bold"
        android:background="@color/text_background"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/guideline2"
        app:layout_constraintBottom_toTopOf="@id/sw_dts1" />

    <!-- Switch + Spinner -->
    <Switch
        android:id="@+id/sw_dts1"
        android:layout_width="0dp"
        android:layout_height="@dimen/sw_h1"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="10dp"
        android:padding="10dp"
        android:text="Confirme"
        android:textStyle="bold"
        android:textSize="@dimen/inner_text_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/pay_dts_select1"
        app:layout_constraintBottom_toTopOf="@id/butt_dts2"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Spinner
        android:id="@+id/pay_dts_select1"
        android:layout_width="0dp"
        android:layout_height="@dimen/sw_h1"
        android:layout_marginStart="8dp"
        android:enabled="false"
        android:gravity="center"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="@id/sw_dts1"
        app:layout_constraintBottom_toBottomOf="@id/sw_dts1"
        app:layout_constraintStart_toEndOf="@id/sw_dts1"
        app:layout_constraintEnd_toEndOf="@id/guideline2" />

    <!-- Botones inferiores (anclados al fondo) -->
    <Button
        android:id="@+id/butt_dts2"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h1"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="24dp"
        android:enabled="false"
        android:text="Eliminar"
        android:textSize="@dimen/inner_text_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="@id/guideline"
        app:layout_constraintEnd_toStartOf="@id/butt_dts3"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/butt_dts3"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_h1"
        android:layout_marginStart="10dp"
        android:text="Aceptar"
        android:textSize="@dimen/inner_text_2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="@id/butt_dts2"
        app:layout_constraintBottom_toBottomOf="@id/butt_dts2"
        app:layout_constraintStart_toEndOf="@id/butt_dts2"
        app:layout_constraintEnd_toEndOf="@id/guideline2" />
    <!-- Guidelines -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="30dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="30dp" />

</androidx.constraintlayout.widget.ConstraintLayout>