<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list1Layout"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/text_background2"
    android:orientation="horizontal"
    android:padding="2dp">

    <!-- Card con imagen -->
    <androidx.cardview.widget.CardView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginEnd="12dp"
        android:radius="20dp"
        android:background="@color/text_background2"
        app:cardElevation="4dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/text_background2"
            android:src="@drawable/image_icon" />

        <!-- Contador (número grande) -->
        <TextView
            android:id="@+id/viewCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="2dp"
            android:background="@color/text_top_image"
            android:gravity="center"

            android:maxLines="1"
            android:minWidth="35dp"
            android:minHeight="35dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="2dp"

            android:radius="20dp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"

            android:shadowRadius="2"

            android:text="0"
            android:textColor="@color/text_color_counter"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Contador Input -->
        <com.example.salesrecord.CurrencyEditText
            android:id="@+id/inputCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="2dp"
            android:background="@color/text_top_image"
            android:gravity="center"

            android:maxLines="1"
            android:minWidth="25dp"
            android:minHeight="25dp"
            android:paddingHorizontal="2dp"
            android:paddingVertical="2dp"

            android:radius="20dp"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"

            android:text="0"
            android:textColor="@color/text_color_counter"
            android:textSize="16sp"
            android:textStyle="bold"

            android:ems="10"
            android:imeOptions="actionDone"
            android:maxLength="20"
            android:padding="10dp"
            android:visibility="invisible"
            android:textIsSelectable="true"
            android:focusable="true"
            android:enabled="true"
            android:privateImeOptions="nm"


            app:localeTag="ES"
            app:maxNumberOfDecimalDigits="2"
            app:keepFocusOnKeyboardClose="false"
            app:layout_constraintTop_toBottomOf="@+id/homeText1"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintEnd_toStartOf="@id/butt_home1" />
    </androidx.cardview.widget.CardView>


    <!-- Contenido de texto -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="2dp">

        <TextView
            android:id="@+id/tex1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:padding="2dp"
            android:textSize="@dimen/inner_text_1" />

        <TextView
            android:id="@+id/tex2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:textSize="@dimen/inner_text_1" />

        <TextView
            android:id="@+id/tex3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:textSize="@dimen/inner_text_1" />

    </LinearLayout>
    <!-- Contenido de texto -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:padding="10dp">

        <Button
            android:id="@+id/buttDel1"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="60dp"
            android:minHeight="32dp"
            android:textSize="@dimen/inner_text_2"
            android:padding="0dp"
            android:text="X" />

    </LinearLayout>

</LinearLayout>