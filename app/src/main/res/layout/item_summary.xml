<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/summary_Layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/normal_background"
    android:orientation="horizontal"
    android:padding="2dp">


    <!-- Botón Agregar -->
    <Button
        android:id="@+id/butt_summary"
        android:layout_width="@dimen/button_wss"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:textColor="@color/inner_button"
        android:backgroundTint="@color/button"
        android:padding="1dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:text="+"
        android:textStyle="bold"
        android:textSize="@dimen/inner_text_2" />

    <!-- Contenido de texto -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/summary_tex1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:padding="2dp"
            android:textSize="@dimen/inner_text_1" />

        <TextView
            android:id="@+id/summary_tex2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="2dp"
            android:textSize="@dimen/inner_text_1" />

    </LinearLayout>

</LinearLayout>