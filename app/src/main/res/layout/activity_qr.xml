<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/fullscreenBackgroundColor"
    android:theme="@style/ThemeOverlay.SalesRecord.FullscreenContainer"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activitys.QrActivity">

    <!-- CONTENEDOR ELÁSTICO CENTRAL (Ocupa todo el espacio restante de la pantalla) -->

    <!-- TEXTO 1: Etiqueta estática "Total:" -->
    <TextView
        android:id="@+id/txtTotalLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:text="Total:"
        android:textColor="#88FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- TEXTO 2: Cantidad numérica dinámica recibida por el Intent -->
    <TextView
        android:id="@+id/qrAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="0.00"
        android:textColor="#FFFFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="0dp">

        <!-- IMAGE VIEW DINÁMICO (Se adapta al ancho disponible pero no se deforma) -->
        <ImageView
            android:id="@+id/imgQrCode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@android:color/white"
            android:padding="10dp"
            android:elevation="4dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

    </FrameLayout>

    <!-- BARRA INFERIOR DE CONTROLES (Fijada abajo de forma absoluta) -->
    <LinearLayout
        android:id="@+id/fullscreen_content_controls"
        style="@style/Widget.Theme.SalesRecord.ButtonBar.Fullscreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <Button
            android:id="@+id/dummy_button"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar" />

    </LinearLayout>

</LinearLayout>
