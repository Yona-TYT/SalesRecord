<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.addAtr.AddAtrFragment">

    <!-- ScrollView para que el formulario sea desplazable (hay muchos campos) -->
    <ScrollView
        android:id="@+id/scroll_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_aceptar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp">



            <!-- ========================================= -->
            <!-- CAMPOS STRING (inputType="text")          -->
            <!-- ========================================= -->


            <!-- nombre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Artículo"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/et_nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="Nombre del artículo"
                android:layout_marginBottom="16dp"
                android:tag="Campo de nombre no debe estar Vacio!"

                />

            <!-- descr -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/et_descr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="1"
                android:hint="Descripción del artículo"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo de Artículo (Unidad, Paquete, Caja)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <Spinner
                android:id="@+id/select1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="0"
                android:text="0"
                android:layout_marginBottom="16dp" />


            <!-- ========================================= -->
            <!-- PRECIOS (Double → inputType="numberDecimal") -->
            <!-- ========================================= -->

            <!-- precund -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Precio Producto"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.example.salesrecord.CurrencyEditText
                    android:id="@+id/et_precio"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/input_h1"
                    android:focusable="true"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:layout_marginEnd="0dp"
                    android:hint="0,00 $"
                    android:inputType="numberDecimal"
                    android:tag="Este valor debe ser mayor a 0"

                    app:localeTag="ES"
                    app:maxNumberOfDecimalDigits="2"
                    app:currencySymbol="$"
                    app:currencySymbolSuffix="true"

                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/add_sw_bs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"

                        android:text="Bolívares"
                        android:checked="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- margen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Margen de Ganancia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <com.example.salesrecord.CurrencyEditText
                android:id="@+id/et_margen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="0,00 %"
                android:focusable="true"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:layout_marginBottom="24dp"

                app:localeTag="ES"
                app:maxNumberOfDecimalDigits="2"
                app:currencySymbol="%"
                app:currencySymbolSuffix="true"

                />

            <!-- ========================================= -->
            <!-- SELECTORES / ENTEROS (inputType="number") -->
            <!-- ========================================= -->

            <!-- totalcount -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cantidad Total de Unidades"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <com.example.salesrecord.CurrencyEditText
                android:id="@+id/et_totalcount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:hint="0,00 uds."
                android:layout_marginBottom="16dp"
                android:focusable="true"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:tag="Este valor debe ser mayor a 0"

                app:localeTag="ES"
                app:maxNumberOfDecimalDigits="2"
                app:currencySymbol="uds."
                app:currencySymbolSuffix="true"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Paquete/Caja Abierto? (0 = No, 1 = Sí)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/et_isopen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="0"
                android:text="0"
                android:layout_marginBottom="16dp" />



            <!-- metrica -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Métrica (0 = sin unidad, 1 = Kg, 2 = L, etc.)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/select2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- caduca -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tiempo de Caducidad (días)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/et_caduca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="0"
                android:text="0"
                android:layout_marginBottom="32dp" />


            <ImageButton
                android:id="@+id/add_btn_image"
                android:layout_width="match_parent"
                android:layout_gravity="center_vertical"

                android:layout_height="40dp"
                android:backgroundTint="@color/float_button"
                android:padding="10dp"
                app:srcCompat="@android:drawable/ic_menu_gallery" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:id="@+id/add_img_preview"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:scaleType="centerCrop"
                    android:background="@color/text_background"
                    android:contentDescription="Vista previa de la imagen"
                    tools:srcCompat="@tools:sample/backgrounds/scenic"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Botón Aceptar (siempre visible al fondo) -->
    <Button
        android:id="@+id/btn_aceptar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aceptar"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>